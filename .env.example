# OpenRouter — text / marketing agent
OPENROUTER_API_KEY=sk-or-v1-...
# Optional override (default: openai/gpt-4o-mini)
OPENROUTER_MODEL=openai/gpt-4o-mini

# FAL.ai — image generation & enhancement
FAL_KEY=...

# Used as HTTP-Referer for OpenRouter rankings (optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Turso (libSQL) — omit or leave placeholders to use local file:local.db
TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# OpenRouter — text / marketing agent
OPENROUTER_API_KEY=sk-or-v1-...
# Optional override (default: openai/gpt-4o-mini)
OPENROUTER_MODEL=openai/gpt-4o-mini

# FAL.ai — image generation & enhancement
FAL_KEY=...

# Used as HTTP-Referer for OpenRouter rankings (optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Turso (libSQL) — omit or leave placeholders to use local file:local.db
TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# NextAuth (Auth.js) — Google OAuth
AUTH_TRUST_HOST=true
# Generate AUTH_SECRET: `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="your-random-32-character-secret"
# Legacy alias (also accepted):
# NEXTAUTH_SECRET="your-random-32-character-secret"
# Preferred Auth.js v5 names:
AUTH_GOOGLE_ID="your-client-id"
AUTH_GOOGLE_SECRET="your-client-secret"
# Legacy aliases also supported:
GOOGLE_CLIENT_ID="your-client-id"
GOOGLE_CLIENT_SECRET="your-client-secret"
# Callback URL to register in Google Cloud Console:
# http://localhost:3000/api/auth/callback/google

# Meta (Facebook / Instagram) — optional; Connect Center stubs OAuth without these
# META_APP_ID=
# META_APP_SECRET=
# Legacy aliases: FACEBOOK_CLIENT_ID / FACEBOOK_CLIENT_SECRET
# or AUTH_FACEBOOK_ID / AUTH_FACEBOOK_SECRET
